```json
{
  "startLatitude": null,
  "startLongitude": null,
  "startLocationText": "Bangalore",
  "destinations": ["Mysore"],
  "budget": 5000,
  "currency": "INR",
  "preferences": "relaxed pace, 1 day trip tomorrow"
}

```

